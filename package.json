  },
  "packageManager": "pnpm@10.2.1",
  "devDependencies": {
    "@babel/generator": "^8.1.3",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.7",
    "dedent": "^1.7.2",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@babel/core": "^8.1.3",
    "@babel/parser": "^8.1.3",
    "@babel/traverse": "^8.1.3",
    "@babel/types": "^8.1.3"
  },
  "prettier": {
    "semi": false
  },
  "files": [
    "dist"
